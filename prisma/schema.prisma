// The Champions Club data model. PostgreSQL is the source of truth;
// the API and any future mobile app read and write through this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
  FRONT_DESK
  BAR
  SHOP
}

enum TabState {
  OPEN
  SETTLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  LOST
}

enum BookingType {
  REGULAR
  FRIDAY_SOCIAL
  TRIAL
}

enum BookingState {
  BOOKED
  CANCELLED
}

enum Category {
  GEAR
  BAR
}

enum PayMethod {
  CASH
  CARD
  UPI
  ONLINE // Razorpay checkout (test mode)
}

model Plan {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  tennisPrice  Int @default(0) // rupees per hour on a tennis court
  cricketPrice Int @default(0) // rupees per hour on a cricket court
  shopDiscount Int // percent
  barDiscount  Int // percent
  termDays     Int
  members      Member[]
  renewals     MembershipRenewal[]
}

model Court {
  id          Int       @id @default(autoincrement())
  name        String
  sport       String
  walkinPrice Int // rupees per hour for non-members
  bookings    Booking[]
}

model Member {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @default("")
  email     String?   @unique // portal login; set by the front desk
  passwordHash String? // portal password; defaults to the phone number
  planId    Int
  plan      Plan      @relation(fields: [planId], references: [id])
  joinedOn  DateTime  @db.Date
  expiresOn DateTime  @db.Date
  dateOfBirth DateTime? @db.Date // Junior members must be under 18 — checked against joinedOn
  bookings  Booking[]
  orders    Order[]
  tabs      Tab[]
  renewals  MembershipRenewal[]
  createdAt DateTime  @default(now())

  @@index([name])
}

model Booking {
  id        Int          @id @default(autoincrement())
  courtId   Int
  court     Court        @relation(fields: [courtId], references: [id])
  memberId  Int?
  member    Member?      @relation(fields: [memberId], references: [id])
  who       String // name as booked: member name, walk-in or trial guest
  phone     String       @default("")
  date      DateTime     @db.Date
  start     Int // minutes from midnight, on the 30-minute grid
  type      BookingType  @default(REGULAR)
  price     Int // rupees, set from the plan or the walk-in rate at booking time
  state     BookingState @default(BOOKED)
  payMethod String? // how the court was paid — CASH | CARD | UPI | ONLINE; null when not recorded
  payState  String? @default("UNPAID") // UNPAID | PAID
  paidAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([courtId, date])
  @@index([date, who])
  @@index([memberId])
}

model Product {
  id       Int         @id @default(autoincrement())
  name     String
  price    Int
  stock    Int? // null for bar items, which are not stocked
  lowAt    Int         @default(5)
  category Category
  imageUrl String? // photo for the shop / bar card; name-based fallback when empty
  items    OrderItem[]
  tabItems TabItem[]
}

model Order {
  id        Int         @id @default(autoincrement())
  memberId  Int?
  member    Member?     @relation(fields: [memberId], references: [id])
  name      String      @default("") // buyer name for pickup
  phone     String      @default("")
  subtotal  Int
  discount  Int         @default(0)
  total     Int
  payMethod PayMethod
  fulfilment String     @default("PICKUP") // PICKUP | DELIVERY
  address   String? // delivery address, set only for DELIVERY
  payState  String      @default("PAID") // PENDING | PAID — online orders start PENDING
  status    String      @default("PLACED") // PLACED | PACKED | DELIVERED | CANCELLED
  deliveredAt DateTime?
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([createdAt])
  @@index([memberId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Int // price at the time of sale

  @@unique([orderId, productId])
}

model Tab {
  id          Int       @id @default(autoincrement())
  memberId    Int?
  member      Member?   @relation(fields: [memberId], references: [id])
  who         String    @default("") // name on the tab
  tableNo     Int?
  status      TabState  @default(OPEN)
  planCode    String    @default("walkin") // plan the discount came from, kept as a snapshot
  discountPct Int       @default(0)
  subtotal    Int       @default(0)
  total       Int       @default(0)
  payMethod   PayMethod?
  openedAt    DateTime  @default(now())
  settledAt   DateTime?
  items       TabItem[]

  @@index([settledAt])
  @@index([memberId])
}

// Owner finance, kept light: bills the club sends out, money going
// out, and the monthly staff pay record. One small table each.
model Invoice {
  id       Int       @id @default(autoincrement())
  billedTo String // member or business client
  detail   String    @default("") // what it is for
  amount   Int // rupees
  status   String    @default("UNPAID") // UNPAID | PAID
  issuedOn DateTime  @default(now())
  paidAt   DateTime?
  taxRate   Int? // percent charged on this invoice, if any
  taxAmount Int? // rupees of tax included in amount
  memberId  Int? // member this bill is for, when it is one
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("General") // Rent, Utilities, Supplies, Maintenance, Other
  amount    Int // rupees
  spentOn   DateTime // the day the money went out (UTC date)
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Payroll {
  id        Int      @id @default(autoincrement())
  staffName String
  month     String // "2026-11"
  salary    Int // rupees for the month
  leaveDays Int      @default(0)
  tax       Int      @default(0) // tax deducted, rupees
  status    String   @default("PENDING") // PENDING | PAID
  staffId   Int? // Staff row this pay belongs to (set from the roster name)
  createdAt DateTime @default(now())

  @@unique([staffId, month])
}

model Enquiry {
  id        Int           @id @default(autoincrement())
  name      String
  contact   String // phone or email, as the visitor gave it
  interest  String // Membership, Free trial, Courts, Shop, Other
  message   String        @default("")
  status    EnquiryStatus @default(NEW)
  note      String        @default("") // staff follow-up note
  quotePlan   String? // plan name on the quote sent, if any
  quoteAmount Int? // rupees quoted
  quoteNote   String        @default("") // what the quote covered
  quotedAt    DateTime? // when the quote was sent/recorded
  memberId  Int? // set when the enquiry converts to a member
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model TabItem {
  id        Int     @id @default(autoincrement())
  tabId     Int
  tab       Tab     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Int

  @@unique([tabId, productId])
}

model Staff {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String
  pinHash      String?
  role         Role    @default(STAFF)
  shifts       Shift[]
  leaves       Leave[]
}

// The rota: who works which part of which day. One row per assignment.
model Shift {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id])
  date      DateTime // the day (UTC date)
  part      String // MORNING | EVENING
  createdAt DateTime @default(now())

  @@unique([staffId, date, part])
}

// Leave: a staff member's time off. Approved leave is the source of
// truth for Payroll.leaveDays; assignShift must refuse shifts that
// overlap approved leave (enforced by the caller, not the schema).
model Leave {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id])
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  type      String // ANNUAL | SICK | UNPAID | OTHER
  reason    String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  @@index([staffId])
}

// MembershipRenewal: the paper trail for a member renewing a plan —
// the booking error promises the front desk "can renew it in a minute",
// and this is the record that renewal leaves behind.
model MembershipRenewal {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id])
  planId      Int
  plan        Plan     @relation(fields: [planId], references: [id])
  amount      Int // rupees paid for the renewal
  payMethod   String // CASH | CARD | UPI | ONLINE
  renewedFrom DateTime @db.Date
  renewedTo   DateTime @db.Date
  createdAt   DateTime @default(now())

  @@index([memberId])
}
